{
  // Must match the deployed Worker (snug-co-client.snugandco-ke.workers.dev); a different name deploys a second,
  // separate Worker and leaves the live one untouched.
  "name": "snug-co-client",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    // The Render API this site proxies /api, /uploads, /share and /sitemap.xml to.
    "API_ORIGIN": "https://snug-co-server.onrender.com"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Page routes fall back to index.html here, so no public/_redirects catch-all is needed
    // (it fails the deploy with error 100324).
    "not_found_handling": "single-page-application",
    // Every page runs the Worker first (/api, /uploads, /share, /sitemap.xml, /product, /shop, /collections
    // are proxied or share-routed there), so it can also add X-Robots-Tag to
    // HTML on workers.dev / onrender.com hostnames. /assets, /images and the root files in dist/ are
    // served straight from the assets. A "!" rule wins over a positive one, so never negate a pattern
    // that also covers a proxied path (/sitemap.xml, /uploads/*.webp).
    "run_worker_first": ["/*", "!/assets/*", "!/images/*", "!/robots.txt", "!/favicon.png", "!/apple-touch-icon.png", "!/og-default.jpg", "!/snug-logo.svg", "!/googled93ea16b0f6a8180.html"]
  }
}
